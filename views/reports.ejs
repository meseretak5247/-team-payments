<% layout('layout') -%>\n\nh2>Reports</h2>\n\n<p><a href="/reports/csv">Download CSV of all payments</a></p>\n\n<table>\n  <thead><tr><th>Member</th><th>Email</th><th>Total Due</th><th>Total Paid</th></tr></thead>\n  <tbody>\n    <% summary.forEach(s => { %>\n      <tr>\n        <td><%= s.name %></td>\n        <td><%= s.email %></td>\n        <td>$<%= parseFloat(s.totalDue || 0).toFixed(2) %></td>\n        <td>$<%= parseFloat(s.totalPaid || 0).toFixed(2) %></td>\n      </tr>\n    <% }) %>\n  </tbody>\n</table>