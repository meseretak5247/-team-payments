<% layout('layout') -%>\n\n<section>\n  <h2>Dashboard — <%= monthStart %></h2>\n  <p>Monthly total due: <strong>$<%= totalDue.toFixed(2) %></strong></p>\n  <p>Monthly total paid: <strong>$<%= totalPaid.toFixed(2) %></strong></p>\n\n  <h3>Members</h3>\n  <ul>\n    <% members.forEach(m => { %>\n      <li><strong><%= m.name %></strong> — last payment:  \n        <% if (m.Payments && m.Payments.length) { %>\n          <%= m.Payments[0].dueDate %> (<%= m.Payments[0].status %>)\n        <% } else { %>\n          no payments\n        <% } %>\n      </li>\n    <% }) %>\n  </ul>\n</section>