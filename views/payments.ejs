<% layout('layout') -%>\n\nh2>Payments</h2>\n\n<form method="POST" action="/payments">\n  <select name="memberId" required>\n    <option value="">Select member</option>\n    <% const allMembers = await (() => require('../models').Member.findAll({ order: [['name','ASC']] }))() %>\n    <% for (const m of allMembers) { %>\n      <option value="<%= m.id %>"><%= m.name %></option>\n    <% } %>\n  </select>\n  <input name="amount" type="number" step="0.01" placeholder="Amount" required />\n  <input name="dueDate" type="date" required />\n  <input name="notes" placeholder="Notes" />\n  <button type="submit">Create Payment</button>\n</form>\n\n<table>\n  <thead><tr><th>Member</th><th>Amount</th><th>Due</th><th>Status</th><th>Checklist</th><th>Actions</th></tr></thead>\n  <tbody>\n    <% payments.forEach(p => { %>\n      <tr>\n        <td><%= p.Member ? p.Member.name : '—' %></td>\n        <td>$<%= parseFloat(p.amount).toFixed(2) %></td>\n        <td><%= p.dueDate %></td>\n        <td><%= p.status %> <%= p.paidAt ? ('at ' + new Date(p.paidAt).toLocaleString()) : '' %></td>\n        <td>\n          <ul>\n            <% (p.Checklists || []).forEach(c => { %>\n              <li>\n                <form style="display:inline" method="POST" action="/checklist/<%= c.id %>/toggle">\n                  <button type="submit"><%= c.done ? '☑' : '☐' %></button>\n                </form>\n                <%= c.title %>\n              </li>\n            <% }) %>\n          </ul>\n        </td>\n        <td>\n          <% if (p.status === 'pending') { %>\n            <form method="POST" action="/payments/<%= p.id %>/pay" style="display:inline">\n              <button type="submit">Mark Paid</button>\n            </form>\n          <% } else { %>\n            <form method="POST" action="/payments/<%= p.id %>/unpay" style="display:inline">\n              <button type="submit">Mark Pending</button>\n            </form>\n          <% } %>\n        </td>\n      </tr>\n    <% }) %>\n  </tbody>\n</table>